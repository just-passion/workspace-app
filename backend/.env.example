# Server
PORT=5000
NODE_ENV=development

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRES_IN=7d

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=workspace_db

# MongoDB
MONGO_URI=mongodb://localhost:27017/workspace_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=workspace-app
KAFKA_GROUP_ID=workspace-consumers

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:3000
